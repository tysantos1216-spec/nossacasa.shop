/* Preloader Full Screen Container */
#bakery-preloader {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #f7f4eb; /* Soft, warm background color matching your brand tone */
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 99999; /* Makes sure it stays completely on top of everything else */
  opacity: 1;
  transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1); /* Beautiful smooth transition */
}

/* Centered Content Styling */
.preloader-content {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

/* Logo Dimensions & Subtle Breathing Animation */
.preloader-logo {
  width: 180px; /* Adjust size to fit your design perfectly */
  height: auto;
  border-radius: 50%; /* Perfect circle matching your layout style */
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  animation: logoPulse 2s ease-in-out infinite;
}

/* Soft Spinning Indicator below the Logo */
.loading-spinner {
  width: 30px;
  height: 30px;
  border: 3px solid rgba(139, 92, 26, 0.1); /* Match your warm theme accent colors */
  border-top: 3px solid #3d6346; /* Beautiful green accent from your flag accents */
  border-radius: 50%;
  animation: spinLoader 1s linear infinite;
}

/* Hidden Utility Class for JavaScript Triggers */
.preloader-hidden {
  opacity: 0 !important;
  pointer-events: none; /* Allows clicks to pass through after it goes invisible */
}

/* Animations Keyframes */
@keyframes logoPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}

@keyframes spinLoader {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}// Function to hide the preloader smoothly
window.addEventListener('load', function() {
  const preloader = document.getElementById('bakery-preloader');
  if (preloader) {
    // Adds the fadeout transition class
    preloader.classList.add('preloader-hidden');
    
    // Completely deletes it from the layout after fading out to save browser memory
    setTimeout(() => {
      preloader.remove();
    }, 600); 
  }
